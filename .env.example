# Local development only. Never reuse these checked-in placeholders in production.
# API runtime
API_PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://panshi:panshi_local@127.0.0.1:5433/panshi_ai4s_camp
TEST_DATABASE_URL=postgresql://panshi:panshi_local@127.0.0.1:5433/panshi_ai4s_camp_test
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
HEALTHCHECK_TIMEOUT_MS=2000
JSON_BODY_LIMIT=1mb
SESSION_TTL_SECONDS=28800
TRUST_PROXY=false
RATE_LIMIT_LOGIN_FAILURE_MAX=5
RATE_LIMIT_LOGIN_FAILURE_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=180
RATE_LIMIT_ADMIN_WINDOW_MS=60000
FILE_STORAGE_ROOT=var/uploads
FILE_UPLOAD_TEMP_ROOT=var/uploads/.incoming
FILE_UPLOAD_MAX_BYTES=5242880
FILE_UPLOAD_GLOBAL_CONCURRENCY=4
FILE_UPLOAD_GLOBAL_WINDOW_MAX=20
FILE_UPLOAD_GLOBAL_WINDOW_MS=60000
FILE_UPLOAD_PER_USER_CONCURRENCY=1
FILE_UPLOAD_PER_USER_WINDOW_MAX=5
FILE_UPLOAD_PER_USER_WINDOW_MS=60000
BACKUP_ROOT=var/backups
APP_VERSION=development
VERIFICATION_PROVIDER=disabled
VERIFICATION_TTL_SECONDS=300
VERIFICATION_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
# To use the development-only mock provider, set VERIFICATION_PROVIDER=mock and add a locally generated
# VERIFICATION_SECRET containing exactly 64 hex characters (32 random bytes) in the untracked .env file.
# Example generation: openssl rand -hex 32. Never commit the value.
# VERIFICATION_MOCK_CODE is accepted only when NODE_ENV=test and must not be placed in this file.

# Browser applications
# Absolute HTTP(S) API base for split-port development; leave empty for same-origin /api/v1 paths.
VITE_API_BASE_URL=http://localhost:3001
# Public Web origin used by the admin's tokenless preview action.
VITE_PUBLIC_WEB_BASE_URL=http://localhost:5173

# Backup/restore scripts (local example values; production container paths are documented in docs/operations.md)
OPERATIONS_UID=
OPERATIONS_GID=
MAINTENANCE_API_HEALTH_URL=http://127.0.0.1:3001/healthz
UPLOAD_ARCHIVE_MAX_COMPRESSED_BYTES=1073741824
UPLOAD_ARCHIVE_MAX_EXPANDED_BYTES=4294967296
UPLOAD_ARCHIVE_MAX_ENTRIES=100000
UPLOAD_ARCHIVE_MAX_PATH_DEPTH=32
RESTORE_MIN_FREE_BYTES=1073741824
BACKUP_RETENTION_DAYS=14
BACKUP_PGHOST=127.0.0.1
BACKUP_PGPORT=5433
BACKUP_PGDATABASE=panshi_ai4s_camp
BACKUP_PGUSER=panshi
BACKUP_PGPASSFILE=/absolute/path/to/backup.pgpass
BACKUP_UPLOAD_DIR=var/uploads
BACKUP_APP_VERSION=development
RESTORE_PGHOST=127.0.0.1
RESTORE_PGPORT=5433
RESTORE_PGDATABASE=panshi_ai4s_camp_restore
RESTORE_PGUSER=panshi
RESTORE_PGPASSFILE=/absolute/path/to/restore.pgpass
RESTORE_UPLOAD_DIR=/absolute/path/to/panshi-restore-uploads
