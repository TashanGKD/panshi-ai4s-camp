{
  "name": "panshi-ai4s-camp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "node tests/workspaces.test.mjs && npm run build -w @panshi/contracts && node --test tests/release-runner.test.mjs tests/cli-docs.test.mjs && npm run test:parity && npm run test:e2e-startup && npm run test:deployment && npm run test:workspaces",
    "test:release": "node scripts/run-release-tests.mjs",
    "build:cli-release": "node scripts/build-cli-release.mjs",
    "check:cli-release": "node scripts/check-cli-release.mjs",
    "test:cli-release": "node --test tests/cli-release.test.mjs && node scripts/check-cli-release.self-test.mjs",
    "check:parity": "npm run build -w @panshi/contracts && npm run build -w panshi-camp-cli && node scripts/check-web-cli-parity.mjs",
    "test:parity": "npm run build -w @panshi/contracts && npm run build -w panshi-camp-cli && node scripts/check-web-cli-parity.self-test.mjs && node --test tests/web-cli-parity.test.mjs",
    "test:deployment": "node tests/nginx-config-validator.test.mjs && node tests/deployment.test.mjs",
    "test:deployment:build": "node tests/deployment-build.test.mjs",
    "test:backup-restore": "bash tests/backup-restore.test.sh",
    "test:e2e-startup": "node --test tests/e2e-api-server.test.mjs",
    "test:workspaces": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --global document --global Node --global getComputedStyle",
    "visual:test": "playwright test e2e/visual.spec.ts --config=playwright.visual.config.ts",
    "visual:update": "playwright test e2e/visual.spec.ts --config=playwright.visual.config.ts --update-snapshots",
    "e2e:launch": "node scripts/run-launch-e2e.mjs",
    "e2e:content": "playwright test e2e/content-publishing.spec.ts --config=playwright.content.config.ts",
    "e2e:student-auth": "playwright test e2e/student-auth.spec.ts --config=playwright.student-auth.config.ts",
    "e2e:application": "playwright test e2e/application-submit.spec.ts --config=playwright.application.config.ts",
    "e2e:review": "playwright test e2e/review-workflow.spec.ts --config=playwright.review.config.ts",
    "e2e:cli": "node scripts/run-cli-e2e.mjs",
    "test:e2e:all": "node scripts/run-e2e-all.mjs",
    "dev:web": "npm run dev -w @panshi/web",
    "dev:admin": "npm run dev -w @panshi/admin",
    "dev:api": "npm run dev -w @panshi/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "pngjs": "^7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
