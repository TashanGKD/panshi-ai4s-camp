{
  "name": "@panshi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:content": "tsx src/db/seeds/initial-content.ts",
    "dev": "node --watch --env-file=../../.env --import tsx src/server.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@panshi/contracts": "0.0.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "file-type": "22.0.1",
    "libphonenumber-js": "1.13.10",
    "multer": "2.2.0",
    "pg": "8.23.0",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/pg": "8.21.0",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
